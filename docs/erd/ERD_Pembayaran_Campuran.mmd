    PAYMENTS {
        bigint id PK
        bigint sale_id FK
        bigint payment_method_id FK
        decimal amount
        string status
        string reference_number
    }

    PAYMENT_REFUNDS {
        bigint id PK
        bigint payment_id FK
        decimal refund_amount
        string refund_method
        string status
    }