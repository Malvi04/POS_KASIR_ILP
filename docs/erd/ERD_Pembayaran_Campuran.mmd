erDiagram
    SALES ||--|{ PAYMENTS : has
    PAYMENT_METHODS ||--o{ PAYMENTS : uses
    PAYMENTS ||--o{ PAYMENT_REFUNDS : refunded_by
    SALES ||--o{ SALES_RETURNS : has

    SALES {
        bigint id PK
        string invoice_number
        decimal grand_total
        string payment_status
